@using EjercicioPractica_S1.Models

@{
    List<Libro> libros = ViewBag.Libros;
}
<h1>Lista de Libros</h1>

@foreach (var libro in libros)
{
    <table class="table table-responsive-lg">
    <tr>
        <td>
            <h2>@libro.Titulo</h2>
            <p>Autor: @libro.Autor</p>
            <p>Género: @libro.Categoria</p>
            <p>Precio: $@libro.Precio.ToString("F2")</p>
            <p>
                @if (libro.Disponible)
                {
                    <spam><span class="badge bg-success">Disponible</span></spam>
                }
                else
                {
                    <spam><span class="badge bg-danger">No Disponible</span></spam>
                }       


            </p>
        </td>
    </tr>
    </table>
}
    