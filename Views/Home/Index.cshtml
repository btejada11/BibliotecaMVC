@{

    ViewData["Title"] = "Inicio - Biblioteca";          
    @using EjercicioPractica_S1.Models
}
<!-- Sección Hero Estilo Biblioteca -->
<div class="biblioteca-hero text-center mb-5">
    <div class="hero-overlay">
        <div class="container py-5">
            <h1 class="display-4 titulo-biblioteca">Biblioteca Digital</h1>
            <p class="lead subtitulo-biblioteca">Un espacio clásico para el conocimiento moderno. Explora nuestro catálogo de libros, autores y gestiona tus préstamos.</p>
            <a asp-controller="Libros" asp-action="Index" class="btn btn-explorar btn-lg mt-3">Explorar Catálogo</a>
        </div>
    </div>
</div>

<div class="container">
    <!-- Sección de Estadísticas / Datos Rápidos -->
    <div class="row text-center mb-5 quick-stats">
        <div class="col-md-4">
            <div class="stat-box">
                <i class="bi bi-book-half fs-1 text-primary-custom"></i>
                <h3 class="mt-2">+1,200</h3>
                <p class="text-muted">Libros Disponibles</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-box">
                <i class="bi bi-people-fill fs-1 text-primary-custom"></i>
                <h3 class="mt-2">+350</h3>
                <p class="text-muted">Autores Registrados</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-box">
                <i class="bi bi-journal-check fs-1 text-primary-custom"></i>
                <h3 class="mt-2">24/7</h3>
                <p class="text-muted">Acceso Digital</p>
            </div>
        </div>
    </div>

    <!-- Sección de Servicios Diferenciados -->
    <div class="container mt-5">
        <h2 class="text-center seccion-titulo mb-4">Servicios De La Biblioteca</h2>
        <div class="row">
            <div class="row g-4">
                @await Html.PartialAsync("_ServiceCard", new EjercicioPractica_S1.Models.ServiceClass { ImageUrl = "/images/libros.jpg", Title = "Gestión de Libros", Text = "(1)Administra y consulta información detallada sobre todos los libros y volúmenes disponibles en la biblioteca.", Controller = "Libros", Action = "Index" })
                @await Html.PartialAsync("_ServiceCard", new EjercicioPractica_S1.Models.ServiceClass { ImageUrl = "/images/autores.jpg", Title = "Directorio de Autores", Text = "(2)Explora las biografías, nacionalidades y listas completas de las mentes detrás de tus obras favoritas.", Controller = "Autor", Action = "Index" })
                @await Html.PartialAsync("_ServiceCard", new EjercicioPractica_S1.Models.ServiceClass { ImageUrl = "/images/prestamos.jpg", Title = "Control de Préstamos", Text = "(3)Lleva un registro estricto de los libros prestados, usuarios activos, fechas de entrega y devoluciones.", Controller = "Prestamos", Action = "Index" })
            </div>
        </div>
    </div>
   
</div>
